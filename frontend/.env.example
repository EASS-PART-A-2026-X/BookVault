# Base URL of the Book Vault API (no trailing slash). Read at dev/build time.
# Default "/api": same origin, forwarded to the backend by the Vite dev server
# (vite.config.ts) or by nginx (Docker). Set a full URL only to call an API on
# another origin directly (it must then allow this origin in CORS_ORIGINS).
VITE_API_URL=/api

# Dev server only: where /api is forwarded.
API_PROXY_TARGET=http://localhost:8000

# Dev server only: where /api/ai is forwarded (the AI service).
AI_PROXY_TARGET=http://localhost:8100

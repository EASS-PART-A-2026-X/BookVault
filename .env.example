# Copy to .env (gitignored) and fill in. Docker Compose reads .env automatically.
# Never commit a real key.

# ---- AI service -------------------------------------------------------------
# Pydantic AI model name. Leave empty to run without AI: the rest of the app works
# and AI requests answer 503 "AI is not configured".
AI_MODEL=anthropic:claude-haiku-5-5
# Provider key for the model above (only the one your provider needs).
ANTHROPIC_API_KEY=
# Seconds before a model call is abandoned (the API then answers 504).
AI_TIMEOUT_SECONDS=20
# Seconds before a call from the AI service to the backend is abandoned.
BACKEND_TIMEOUT_SECONDS=5

# ---- Sample data (seed) -----------------------------------------------------
# Password for the seeded readers (demo, mira, theo). Leave empty to get a random one,
# printed once by `docker compose logs seed`. 8-128 characters.
DEMO_PASSWORD=
# "false" to start with an empty vault instead.
SEED_DEMO_DATA=true

# ---- Frontend ---------------------------------------------------------------
# Host port for the app (http://localhost:8080).
FRONTEND_PORT=8080
